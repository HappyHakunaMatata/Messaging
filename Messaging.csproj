<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>HappyHakunaMatata.Messaging</PackageId>
    <PackagePatch Condition="'$(PackagePatch)' == ''">0</PackagePatch>
    <Version>2.0.$(PackagePatch)</Version>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NATS.Net" Version="3.3.1" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="UnitTests" />
    <InternalsVisibleTo Include="IntegrationTests" />
    <InternalsVisibleTo Include="Benchmarks" />
  </ItemGroup>

</Project>
